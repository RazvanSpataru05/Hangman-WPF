<Window x:Class="Hangman.Game.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statistics" Height="400" Width="550"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontFamily="Ink Free">

    <Window.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Ink Free"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        </ContentPresenter>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"></ScaleTransform>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/Assets/background.jpg"
                   Stretch="UniformToFill"
                   Opacity="0.9"/>
    </Window.Background>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding DisplayedCategory}"
                   FontSize="24" FontWeight="Bold" FontFamily="Ink Free"
                   HorizontalAlignment="Center" Margin="0 0 0 12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="&lt;" Width="25"
                    VerticalAlignment="Center" 
                    Style="{StaticResource ButtonStyle}"
                    Command="{Binding PreviousPageCommand}"/>

            <DataGrid Grid.Column="1" Margin="8 0"
                      ItemsSource="{Binding DisplayedStatistics}"
                      SelectedItem="{Binding SelectedStatistics}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                    <DataGridTextColumn Header="Games Played" Binding="{Binding GamesPlayed}" Width="*"/>
                    <DataGridTextColumn Header="Games Won" Binding="{Binding GamesWon}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Grid.Column="2" Content="&gt;" Width="25"
                    VerticalAlignment="Center"
                    Style="{StaticResource ButtonStyle}"
                    Command="{Binding NextPageCommand}"/>
        </Grid>
    </Grid>
</Window>