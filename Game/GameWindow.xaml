<Window x:Class="Hangman.Game.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helper="clr-namespace:Hangman.Helper"
        Title="Hangman"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        FontFamily="Ink Free">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Command="{Binding NewGameCommand}" Gesture="Ctrl+N"/>
        <KeyBinding Command="{Binding OpenGameCommand}" Gesture="Ctrl+O"/>
        <KeyBinding Command="{Binding SaveGameCommand}" Gesture="Ctrl+S"/>
        <KeyBinding Command="{Binding StatisticsCommand}" Gesture="Ctrl+T"/>
        <KeyBinding Command="{Binding AboutCommand}" Gesture="Ctrl+H"/>
    </Window.InputBindings>
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helper:StringToImageConverter x:Key="StringToImageConverter"/>
        

        <Style x:Key="LetterButtonStyle"  TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Ink Free"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Line x:Name="Strikethrough1"
                              X1="5" Y1="5" X2="35" Y2="35"
                              Stroke="Black" StrokeThickness="2"
                              Visibility="Collapsed"/>
                            <Line x:Name="Strikethrough2"
                                  X1="5" Y1="35" X2="35" Y2="5"
                                  Stroke="Black" StrokeThickness="2" 
                                  Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Strikethrough1" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Strikethrough2" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                         </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/Assets/background.jpg"
                   Stretch="UniformToFill"
                   Opacity="0.9"/>
    </Window.Background>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New Game" Command="{Binding NewGameCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Open Game" Command="{Binding OpenGameCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="Save Game" Command="{Binding SaveGameCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Statistics" Command="{Binding StatisticsCommand}" InputGestureText="Ctrl+T"/>
                <MenuItem Header="Cancel" Command="{Binding CancelCommand}" InputGestureText="Esc"
                          CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </MenuItem>
            <MenuItem Header="Categories">
                <MenuItem Header="All Categories" Command="{Binding SelectCategoryCommand}"
                          CommandParameter="AllCategories" IsCheckable="True">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Category}" Value="AllCategories">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="Mathematics" Command="{Binding SelectCategoryCommand}"
                          CommandParameter="Mathematics" IsCheckable="True">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Category}" Value="Mathematics">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="Programming" Command="{Binding SelectCategoryCommand}"
                          CommandParameter="Programming" IsCheckable="True">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Category}" Value="Programming">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="Physics" Command="{Binding SelectCategoryCommand}"
                          CommandParameter="Physics" IsCheckable="True">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Category}" Value="Physics">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="Biology" Command="{Binding SelectCategoryCommand}"
                          CommandParameter="Biology" IsCheckable="True">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Category}" Value="Biology">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" Command="{Binding AboutCommand}" InputGestureText="Ctrl+H"/>
            </MenuItem>
        </Menu>

        <Grid>
            <StackPanel Visibility="{Binding IsGameInactive, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Welcome to Hangman!"
                           HorizontalAlignment="Center"
                           FontSize="28"
                           FontWeight="Bold"
                           FontFamily="Ink Free"
                           Margin="0 0 0 15"/>
                <TextBlock Text="Select a category from the menu,"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontFamily="Ink Free"/>
                <TextBlock Text="then press New Game or load a save."
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontFamily="Ink Free"/>
            </StackPanel>

            <Grid Visibility="{Binding IsGameActive, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Column="0" Grid.Row="0">
                    <Image Source="{Binding DisplayedHangmanImage, Converter={StaticResource StringToImageConverter}}"
                           Stretch="Uniform"
                           Margin="0 150 0 0"/>

                    <TextBlock
                           VerticalAlignment="Top"
                           HorizontalAlignment="Center"
                           Margin="0 130 80 0"
                           FontSize="28"
                           FontWeight="SemiBold"
                           FontFamily="Ink Free"
                           Text="{Binding CurrentLevel, StringFormat='Level: {0}/3'}"/>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="10 10 0 0">
                        <TextBlock Text="{Binding CurrentUser.Name}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   FontFamily="Ink Free"
                                   VerticalAlignment="Center"
                                   Margin="5 5 0 0"/>
                        <Image Source="{Binding CurrentUser.ImagePath, Converter={StaticResource StringToImageConverter}}"
                               Width="80" Height="80" Margin="10 5 0 0"
                               Stretch="Uniform">
                        </Image>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               HorizontalAlignment="Center"
                               Margin="450 20 0 0"
                               FontWeight="SemiBold"
                               FontFamily="Ink Free"
                               FontSize="18">
                        <Run Text="Time Left: "/>
                        <Run Text="{Binding TimeLeft}"/>
                        <Run Text="s"/>
                    </TextBlock>

                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <TextBlock Text="{Binding DisplayedWord}"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   FontFamily="Ink Free"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Viewbox>

                    <WrapPanel Grid.Row="2"
                               HorizontalAlignment="Center"
                               Margin="0 0 10 10">
                        <Button Content="A" Command="{Binding GuessLetterCommands[0]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="B" Command="{Binding GuessLetterCommands[1]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="C" Command="{Binding GuessLetterCommands[2]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="D" Command="{Binding GuessLetterCommands[3]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="E" Command="{Binding GuessLetterCommands[4]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="F" Command="{Binding GuessLetterCommands[5]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="G" Command="{Binding GuessLetterCommands[6]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="H" Command="{Binding GuessLetterCommands[7]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="I" Command="{Binding GuessLetterCommands[8]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="J" Command="{Binding GuessLetterCommands[9]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="K" Command="{Binding GuessLetterCommands[10]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="L" Command="{Binding GuessLetterCommands[11]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="M" Command="{Binding GuessLetterCommands[12]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="N" Command="{Binding GuessLetterCommands[13]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="O" Command="{Binding GuessLetterCommands[14]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="P" Command="{Binding GuessLetterCommands[15]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="Q" Command="{Binding GuessLetterCommands[16]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="R" Command="{Binding GuessLetterCommands[17]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="S" Command="{Binding GuessLetterCommands[18]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="T" Command="{Binding GuessLetterCommands[19]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="U" Command="{Binding GuessLetterCommands[20]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="V" Command="{Binding GuessLetterCommands[21]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="W" Command="{Binding GuessLetterCommands[22]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="X" Command="{Binding GuessLetterCommands[23]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="Y" Command="{Binding GuessLetterCommands[24]}" Style="{StaticResource LetterButtonStyle}"/>
                        <Button Content="Z" Command="{Binding GuessLetterCommands[25]}" Style="{StaticResource LetterButtonStyle}"/>
                    </WrapPanel>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>